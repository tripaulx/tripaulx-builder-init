#: providers/errors.py:58
msgid "Refused by the model"
msgstr "Recusada pelo modelo"

#: providers/errors.py:59
msgid "Provider not installed"
msgstr "Provedor não instalado"

#: providers/errors.py:60
msgid "Unexpected error"
msgstr "Erro inesperado"

#: providers/errors.py:65
msgid "AI is turned off in the workspace settings."
msgstr "A IA está desligada nas configurações do workspace."

#: providers/errors.py:67
msgid "No model chosen for this agent nor in the AI settings."
msgstr "Nenhum modelo escolhido para este agente nem nas configurações de IA."

#: providers/errors.py:68
#, python-format
msgid "The agent “%(name)s” is inactive."
msgstr "O agente “%(name)s” está inativo."

#: providers/errors.py:69
#, python-format
msgid "The coordinator “%(name)s” has no active specialist."
msgstr "O coordenador “%(name)s” não tem nenhum especialista ativo na equipe."

#: providers/errors.py:70
#, python-format
msgid "The required skill “%(name)s” has no published version."
msgstr "A skill obrigatória “%(name)s” não tem versão publicada."

#: providers/errors.py:72
#, python-format
msgid ""
"The daily AI spending cap (US$ %(cap)s) was reached. It resets tomorrow or "
"can be changed in the AI settings."
msgstr ""
"O teto diário de gasto com IA (US$ %(cap)s) foi atingido. Ele reinicia "
"amanhã ou pode ser ajustado nas configurações de IA."

#: providers/errors.py:77
#, python-format
msgid "%(provider)s rejected the API key. Add a valid key in the AI settings."
msgstr ""
"A %(provider)s recusou a chave de API. Cadastre uma chave válida nas "
"configurações de IA."

#: providers/errors.py:80
#, python-format
msgid ""
"The API key has no permission to use this model. Check the account plan at "
"%(provider)s."
msgstr ""
"A chave de API não tem permissão para usar este modelo. Confira o plano da "
"conta na %(provider)s."

#: providers/errors.py:84
#, python-format
msgid ""
"%(provider)s does not know the model “%(model)s”. Check the identifier in "
"the catalog."
msgstr ""
"A %(provider)s não reconhece o modelo “%(model)s”. Confira o identificador "
"no catálogo."

#: providers/errors.py:88
#, python-format
msgid ""
"%(provider)s refused because of a usage limit or missing credits. Check the "
"account balance and limits."
msgstr ""
"A %(provider)s recusou por limite de uso ou falta de créditos. Confira o "
"saldo e os limites da conta."

#: providers/errors.py:92
#, python-format
msgid ""
"%(provider)s rejected the request parameters. The technical detail was "
"recorded in the event."
msgstr ""
"A %(provider)s recusou os parâmetros do pedido. O detalhe técnico ficou "
"registrado no evento."

#: providers/errors.py:96
#, python-format
msgid "%(provider)s is unavailable right now. Try again in a few minutes."
msgstr ""
"A %(provider)s está fora do ar no momento. Tente de novo em alguns minutos."

#: providers/errors.py:98
#, python-format
msgid "%(provider)s did not answer in time (%(seconds)s s)."
msgstr "A %(provider)s não respondeu no tempo esperado (%(seconds)s s)."

#: providers/errors.py:100
#, python-format
msgid "Could not reach %(provider)s: the server has no internet access."
msgstr ""
"Não foi possível falar com a %(provider)s: o servidor está sem acesso à "
"internet."

#: providers/errors.py:103
msgid ""
"The answer was cut by the output token limit. Raise the agent's limit or "
"shorten the input."
msgstr ""
"A resposta foi cortada pelo limite de tokens de saída. Aumente o limite do "
"agente ou reduza a entrada."

#: providers/errors.py:106
msgid "The model did not return JSON in the requested format."
msgstr "O modelo não devolveu o JSON no formato pedido."

#: providers/errors.py:107
msgid "The model declined to answer this request."
msgstr "O modelo se recusou a responder este pedido."

#: providers/errors.py:109
#, python-format
msgid ""
"The %(provider)s client is not installed on the server (install tripaulx-"
"sdk[%(extra)s])."
msgstr ""
"O cliente da %(provider)s não está instalado no servidor (instale tripaulx-"
"sdk[%(extra)s])."

#: providers/errors.py:112
msgid "Unexpected failure calling the AI. The detail was logged."
msgstr "Falha inesperada ao chamar a IA. O detalhe foi registrado."

#: providers/errors.py:148
#, python-format
msgid ""
"The API key has a character that cannot be sent: “%(char)s” (U+%(code)s) at "
"position %(position)s. This usually comes from copy and paste (letters of "
"other alphabets look the same). Add the key again in the AI settings, typed "
"or pasted from the original source."
msgstr ""
"A chave de API tem um caractere que não pode ser enviado: “%(char)s” (U+"
"%(code)s), na posição %(position)s. Isso costuma vir de copiar e colar (há "
"letras de outros alfabetos idênticas às nossas). Cadastre a chave de novo "
"nas configurações de IA, digitando ou colando da fonte original."

