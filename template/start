#!/usr/bin/env bash
# =============================================================================
# start - one command to run the project locally.
#
#   ./start          setup (if needed) and run the dev server on :8000
#   ./start setup    .env.local + database + migrations + bootstrap, then (in a
#                    terminal) asks for the first workspace's owner
#   ./start test     run the test-suite
#   ./start admin    create a workspace administrator (asks name, e-mail and
#                    password twice; extra args go to create_workspace_admin)
#
# Workspaces are served at http://<slug>.<APP_BASE_DOMAIN>:8000
# (*.localhost resolves to 127.0.0.1 in browsers and curl).
# =============================================================================
set -euo pipefail

BASE_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$BASE_DIR"
PORT="${PORT:-8000}"
export DJANGO_SETTINGS_MODULE="${DJANGO_SETTINGS_MODULE:-config.settings.local}"

log() { echo "[start] $*"; }

ensure_env_file() {
  [ -f .env.local ] && return 0
  log "creating .env.local from .env.example (fresh SECRET_KEY and field key)"
  local secret field_key
  secret="$(uv run python -c 'import secrets; print(secrets.token_urlsafe(50))')"
  field_key="$(uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')"
  sed -e "s|^SECRET_KEY=.*|SECRET_KEY=$secret|" \
    -e "s|^APP_FIELD_ENCRYPTION_KEY=.*|APP_FIELD_ENCRYPTION_KEY=$field_key|" \
    .env.example > .env.local
}

# Fill an empty APP_FILE_ENCRYPTION_KEY in .env.local (tripaulx.storage).
ensure_file_key() {
  grep -qE '^APP_FILE_ENCRYPTION_KEY=$' .env.local || return 0
  log "generating APP_FILE_ENCRYPTION_KEY in .env.local (back it up)"
  local key
  key="$(uv run python -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())')"
  sed "s|^APP_FILE_ENCRYPTION_KEY=$|APP_FILE_ENCRYPTION_KEY=$key|" .env.local > .env.local.tmp
  mv .env.local.tmp .env.local
}

setup() {
  uv sync --quiet
  ensure_env_file
  ensure_file_key
  ./pg ensure
  uv run python manage.py migrate_schemas --shared
  uv run python manage.py bootstrap_workspace
  uv run python manage.py migrate_schemas
  onboard_owner
}

# Onboarding: in a terminal, ask for the first workspace's owner (full name,
# e-mail, password twice, checked by AUTH_PASSWORD_VALIDATORS). Skipped when
# the workspace already has one, without a terminal, or with START_SKIP_ADMIN=1.
onboard_owner() {
  local workspace
  workspace="$(bootstrap_workspace)"
  [ -n "$workspace" ] || return 0
  if [ "${START_SKIP_ADMIN:-0}" = "1" ]; then return 0; fi
  if [ -t 0 ] && [ -t 1 ]; then
    uv run python manage.py create_workspace_admin --schema "$workspace" --if-none \
      || log "owner not created; run ./start admin when ready"
  else
    log "no terminal: if '$workspace' has no owner yet, run ./start admin"
  fi
}

base_domain() { grep -E '^APP_BASE_DOMAIN=' .env.local | cut -d= -f2-; }

# Tests run on config.settings.test, which does not read .env.local: export
# its database credentials unless the process already has them (CI).
run_tests() {
  local key value
  for key in DB_NAME DB_USER DB_PASSWORD DB_HOST DB_PORT; do
    value="$(grep -E "^${key}=" .env.local 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
    if [ -n "$value" ] && [ -z "${!key:-}" ]; then export "$key=$value"; fi
  done
  DJANGO_SETTINGS_MODULE=config.settings.test exec uv run pytest "$@"
}

# First workspace from .env.local (overridable with --schema in the args).
bootstrap_workspace() { grep -E '^APP_BOOTSTRAP_WORKSPACE=' .env.local | cut -d= -f2-; }

create_admin() {
  # ${args[@]+...} keeps an empty array safe under `set -u` on macOS bash 3.2.
  local args=("$@")
  if [[ " ${args[*]-} " != *" --schema "* ]]; then
    args=(--schema "$(bootstrap_workspace)" ${args[@]+"${args[@]}"})
  fi
  uv run python manage.py create_workspace_admin "${args[@]}"
}

case "${1:-run}" in
  setup) setup ;;
  test) run_tests "${@:2}" ;;
  admin) create_admin "${@:2}" ;;
  run)
    setup
    log "public:     http://$(base_domain):$PORT/admin/"
    log "workspaces: http://<slug>.$(base_domain):$PORT/admin/"
    log "API docs:   http://$(base_domain):$PORT/api/docs/ (admins)"
    exec uv run python manage.py runserver "0.0.0.0:$PORT"
    ;;
  *) echo "Usage: ./start [run|setup|test|admin]" >&2; exit 2 ;;
esac
