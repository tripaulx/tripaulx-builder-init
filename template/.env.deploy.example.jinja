# Copy to .env.deploy (never committed) and fill in the App Tokens.
# Used only by ./deploy on your machine; never set these in the apps.
#
# Each token comes from its app in CapRover: Deployment > Method 1
# (Official CLI) > "Enable App Token". An App Token can only deploy that one
# app. Never use, store or export the CapRover password here.

CAPROVER_SERVER=https://captain.apps.{{ base_domain }}

# Web app (APP_ROLE=web).
CAPROVER_APP_NAME={{ project_slug | replace('_', '-') }}
CAPROVER_APP_TOKEN=

# Worker app (APP_ROLE=worker).
CAPROVER_WORKER_APP_NAME={{ project_slug | replace('_', '-') }}-worker
CAPROVER_WORKER_APP_TOKEN=

# Seconds ./deploy prod all waits between the web and the worker deploys.
DEPLOY_WORKER_DELAY=60
