"""REST API: DRF, JWT (bound to the workspace schema), OpenAPI and CORS."""

from tripaulx.settings.rest import rest_framework, simple_jwt, spectacular

from .common import get_env, get_env_list

REST_FRAMEWORK = rest_framework()

# Empty JWT_SIGNING_KEY signs with SECRET_KEY.
SIMPLE_JWT = simple_jwt(get_env("JWT_SIGNING_KEY", ""))

# Schema and docs are served to admins only (see config/urls*.py).
SPECTACULAR_SETTINGS = spectacular({{ (project_name ~ " API") | tojson }})

# Browser origins allowed to call the API; local.py allows every origin.
CORS_ALLOWED_ORIGINS = get_env_list("CORS_ALLOWED_ORIGINS")
CORS_URLS_REGEX = r"^/api/.*$"
