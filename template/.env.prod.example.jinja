# Production variables, for reference only: set them in the CapRover apps
# (App Configs > Environment Variables). Never commit real values.
# The web app ({{ project_slug | replace('_', '-') }}) and the worker app ({{ project_slug | replace('_', '-') }}-worker) share every
# variable except the "Role" block. See docs/deployment.md.

# --- Role (differs per app) --------------------------------------------------
# web: APP_ROLE=web, RUN_MIGRATIONS=1 | worker: APP_ROLE=worker, RUN_MIGRATIONS=0
APP_ROLE=web
RUN_MIGRATIONS=1

# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
# uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=0
LOG_LEVEL=INFO
# Change it to hide the admin from scanners (served at /<prefix>/).
ADMIN_URL_PREFIX=admin
# Extra hosts besides .<APP_BASE_DOMAIN> (comma-separated).
ALLOWED_HOSTS=
# Defaults to https:// origins derived from ALLOWED_HOSTS.
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=1

# --- Encryption of stored secrets (tripaulx.core.crypto) ----------------------
# A Fernet key. Losing it makes every encrypted value unreadable: keep a copy.
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_FIELD_ENCRYPTION_KEY=

# --- tripaulx-sdk ------------------------------------------------------------
# Workspaces are served at <slug>.{{ base_domain }}.
APP_BASE_DOMAIN={{ base_domain }}
APP_PUBLIC_DOMAINS=
APP_BOOTSTRAP_WORKSPACE={{ initial_workspace }}
APP_BOOTSTRAP_WORKSPACE_NAME=

# --- Database (CapRover one-click PostgreSQL) ----------------------------------
DB_ENGINE=django_tenants.postgresql_backend
DB_NAME={{ project_slug }}
DB_USER={{ project_slug }}
DB_PASSWORD=
# Internal CapRover hostname of the Postgres app: srv-captain--<app name>.
DB_HOST=srv-captain--{{ project_slug | replace('_', '-') }}-db
DB_PORT=5432
DB_SSLMODE=
DB_CONN_MAX_AGE=60

# --- Cache (CapRover Redis app) -----------------------------------------------
# Required for more than one gunicorn worker or instance (shared cache).
REDIS_URL=redis://:<password>@srv-captain--{{ project_slug | replace('_', '-') }}-redis:6379/0

# --- E-mail (SMTP) -------------------------------------------------------------
MAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_USE_TLS=1
DEFAULT_FROM_EMAIL={{ default_from_email }}

# --- Background tasks (django.tasks) -------------------------------------------
# immediate | database. Use the same value on web and worker; "database"
# needs the worker app running.
DJANGO_TASKS_BACKEND=immediate
TASKS_WORKER_INTERVAL=1
TASKS_QUEUE_NAME=default

# --- Gunicorn (web) --------------------------------------------------------------
# Keep GUNICORN_WORKERS=1 without Redis (the local-memory cache is per process).
GUNICORN_WORKERS=2
# Floor of 2: fewer threads means one request at a time.
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

# --- Container healthcheck ---------------------------------------------------------
# /healthz/ is answered before tenant resolution, so any Host works.
HEALTHCHECK_HOST=localhost
HEALTHCHECK_PATH=/healthz/
HEALTHCHECK_TIMEOUT=4

# --- Object storage (tripaulx.storage, any S3-compatible provider) -------------
# Off until both keys are set. Smoke test: manage.py check_bucket --schema <slug>
APP_S3_ACCESS_KEY=
APP_S3_SECRET_KEY=
APP_S3_BUCKET=
APP_S3_ENDPOINT_URL=
APP_S3_REGION=
APP_S3_URL_TTL=900
APP_S3_MAX_UPLOAD_BYTES=26214400
APP_S3_MAX_IMAGE_BYTES=2097152
APP_S3_MAX_IMAGE_PIXELS=4000000
# Generate with manage.py generate_file_key. LOSING IT LOSES EVERY ENCRYPTED FILE.
APP_FILE_ENCRYPTION_KEY=

# --- Legal documents (tripaulx.legal; files in legal/ override the SDK) -------
# Placeholders of the terms, privacy policy and governance documents. Empty
# values stay visible in the documents: manage.py legal_check lists them.
APP_LEGAL_COMPANY={{ project_name }}
APP_LEGAL_PRODUCT={{ project_name }}
APP_LEGAL_COMPANY_ID=
APP_LEGAL_COMPANY_ADDRESS=
APP_LEGAL_CONTACT_EMAIL=
APP_LEGAL_SECURITY_EMAIL=
APP_LEGAL_SECURITY_OWNER=
APP_LEGAL_DPO_NAME=
APP_LEGAL_DPO_EMAIL=
APP_LEGAL_JURISDICTION=
APP_LEGAL_DATA_LOCATION=
APP_LEGAL_EFFECTIVE_DATE=
# Restricted documents: workspace admins plus these exact e-mail domains
# (comma-separated), in these schemas (empty: every workspace).
APP_LEGAL_ALLOWED_EMAIL_DOMAINS=
APP_LEGAL_SCHEMAS=
