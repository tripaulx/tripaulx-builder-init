# Copy to .env.local (./start does it for you) and adjust.
# Production values are set in the CapRover app, never committed.

# --- Django -----------------------------------------------------------------
SECRET_KEY=
DEBUG=1
LOG_LEVEL=INFO
ADMIN_URL_PREFIX=admin
# Extra hosts besides .<APP_BASE_DOMAIN> (comma-separated).
ALLOWED_HOSTS=

# --- Database (PostgreSQL; django-tenants needs schemas) ---------------------
DB_NAME={{ project_slug }}
DB_USER={{ project_slug }}
DB_PASSWORD={{ project_slug }}
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=
DB_CONN_MAX_AGE=60

# --- Cache (production: required for passkeys with more than one worker) -----
REDIS_URL=

# --- E-mail ------------------------------------------------------------------
# Production defaults to tripaulx.mail.backends.MailgunEmailBackend (configured
# in the public admin); until Mailgun is ready it falls back to SMTP (MAIL_*).
MAIL_BACKEND=django.core.mail.backends.console.EmailBackend
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_USE_TLS=1
DEFAULT_FROM_EMAIL={{ default_from_email }}

# --- API ---------------------------------------------------------------------
# JWT signing key; empty uses SECRET_KEY.
JWT_SIGNING_KEY=
# Browser origins allowed to call the API (comma-separated, production).
CORS_ALLOWED_ORIGINS=

# --- tripaulx-sdk ------------------------------------------------------------
APP_NAME={{ project_name }}
# Local: {{ local_base_domain }} | Production: {{ base_domain }}
APP_BASE_DOMAIN={{ local_base_domain }}
APP_PUBLIC_DOMAINS=
APP_BOOTSTRAP_WORKSPACE={{ initial_workspace }}
APP_BOOTSTRAP_WORKSPACE_NAME=
# Fernet key of encrypted fields (./start generates one; required in prod).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_FIELD_ENCRYPTION_KEY=
# Public URL of the logo at the top of e-mails (empty shows the name).
APP_EMAIL_LOGO_URL=
# Public signup (POST /api/auth/signup/ on the apex domain).
APP_SIGNUP_ENABLED=1
# Passkeys: empty RP ID uses each workspace's host. Extra origins: comma-separated.
APP_WEBAUTHN_RP_ID=
APP_WEBAUTHN_ORIGINS=
